# AutoDezire Server Environment Configuration — EXAMPLE FILE
# Copy this to .env and fill in your real values. Never commit .env to git.

PORT=5000
NODE_ENV=production

# ─── MongoDB ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/autodezire

# ─── JWT Secret ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_random_64_byte_hex_secret_here

# ─── Admin Credentials ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrongAdminPasswordHere

# ─── CORS Allowed Origins ────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── OpenRouter AI Configuration ────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
